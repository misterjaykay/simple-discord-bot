# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Discord bot token (Discord Developer Portal > Bot > Token)
BOT_TOKEN=

# Discord application (client) ID (Discord Developer Portal > General Information)
CLIENT_ID=

# Optional: set this while developing so `npm run deploy-commands` updates commands
# instantly in one server instead of waiting up to an hour for a global deploy.
GUILD_ID=

# MongoDB connection string (birthday/mbti/poll/santa/voicemaster commands need this)
MONGODB_URI=

# Optional: only needed for the /티어 (League of Legends rank lookup) command
RIOT_API_KEY=
